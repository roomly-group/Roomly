VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Cloudflare Turnstile site key (public, safe to ship in the JS bundle).
# From dash.cloudflare.com -> Turnstile -> your widget.
# The matching Secret Key goes ONLY in the Supabase dashboard
# (Authentication -> Attack Protection -> Enable Captcha protection),
# never in this file or in any frontend code.
VITE_TURNSTILE_SITE_KEY=
